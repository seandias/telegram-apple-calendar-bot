# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC...

# Your Telegram user ID (message @userinfobot to get it). Comma-separate to allow Sandra too.
ALLOWED_TELEGRAM_IDS=123456789

# Apple ID email + an APP-SPECIFIC password (not your normal Apple password)
APPLE_ID=you@icloud.com
APPLE_APP_PASSWORD=abcd-efgh-ijkl-mnop

# Calendar to add events to, exactly as named in the Calendar app (blank = first one)
CALENDAR_NAME=Home

# Optional: only check these calendars for clashes (blank = all of them)
CHECK_CALENDARS=

# Count all-day events (holidays, birthdays) as clashes?
ALL_DAY_COUNTS_AS_CONFLICT=false

TIMEZONE=Asia/Singapore
