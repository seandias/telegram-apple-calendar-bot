# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC...

# Who may use the bot. Username (without @) is easiest; numeric IDs also work.
# Comma-separate to allow more people.
ALLOWED_TELEGRAM_USERNAMES=your_username
ALLOWED_TELEGRAM_IDS=

# Apple ID email + an APP-SPECIFIC password (not your normal Apple password)
APPLE_ID=you@icloud.com
APPLE_APP_PASSWORD=abcd-efgh-ijkl-mnop

# Calendar to add events to, exactly as named in the Calendar app (blank = first one)
CALENDAR_NAME=Home

# Optional: only check these calendars for clashes (blank = all of them)
CHECK_CALENDARS=

# Count all-day events (holidays, birthdays) as clashes?
ALL_DAY_COUNTS_AS_CONFLICT=false

TIMEZONE=Asia/Singapore

# Alerts when events appear/move/disappear in your calendar outside the bot (e.g. email invites)
# Check every N minutes (0 = off). Set NOTIFY_CHAT_ID (the bot tells you yours on /start)
# so alerts survive restarts.
WATCH_MINUTES=5
NOTIFY_CHAT_ID=

# Optional read-only extra calendars (e.g. Google): Name|secret iCal URL, comma-separated
EXTRA_ICS_URLS=
